{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "compiled"
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "compiled"]
}
