{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "types": [],
    "outDir": "./compiled"
  },
  "include": ["consumer.ts", "runtime.ts"]
}
